<!-- START BLOCK : blogs-body-->
<h1>Jaunākais blogos</h1>
<p class="core-pager">{pager-next} {pager-numeric} {pager-prev}</p>
<ul id="latest-blogs">
	<!-- START BLOCK : blogs-featured-->
	<li>
		<div class="author">
			<a href="{aurl}"><img class="av" src="{newest-author-avatar}" alt="{newest-author-title}" width="90" height="90" /></a>
			<a href="{aurl}" class="author-name">{newest-author-title}</a>
		</div>
		<div class="blog-content">
			<h3><a href="{url}">{newest-title}</a></h3>
			<p class="blog-meta">Pievienoja <a href="{aurl}">{newest-author-title}</a> &bull; {newest-date} &bull; <a href="{url}#comments">{newest-comments} komentāri</a> &bull; {newest-views} skatījumi</p>
			<div class="intro-text">{newest-text}</div>
			<a href="{url}" class="blogtopics-readmore">Lasīt&nbsp;tālāk&nbsp;&raquo;</a>
		</div>
		<div class="c"></div>
	</li>
	<!-- END BLOCK : blogs-featured-->
</ul>
<div class="c"></div>
<p class="core-pager">{pager-next} {pager-numeric} {pager-prev}</p>
<!-- END BLOCK : blogs-body-->
